# Banco de dados.
# - Desenvolvimento local: SQLite (arquivo), caminho relativo ao projeto.
# - No Docker: o docker-compose sobrescreve com sqlite:////data/dados.db
# - Produção (Neon): cole a connection string do painel do Neon, ex.:
#   DATABASE_URL=postgresql://usuario:senha@ep-xxx-pooler.regiao.aws.neon.tech/visia_db?sslmode=require  # pragma: allowlist secret
#   (use o endpoint "-pooler"; a app aceita postgres:// e adiciona sslmode=require se faltar)
DATABASE_URL=sqlite:///./dados.db

SECRET_KEY=mude-esta-chave-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens permitidas no CORS (separadas por vírgula). Em produção use o domínio real.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
